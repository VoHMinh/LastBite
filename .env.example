# LastBite API — Mẫu biến môi trường
# Sao chép file này thành .env rồi điền giá trị phù hợp.

# Server
SERVER_PORT=8080

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lastbite
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=2s

# JWT (HMAC-SHA512 — tạo bằng: openssl rand -base64 64)
JWT_SIGNER_KEY=
JWT_ACCESS_TOKEN_DURATION=900
JWT_REFRESH_TOKEN_DURATION=604800

# CORS (các origin phân tách bằng dấu phẩy)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookie xác thực / xác minh email
APP_AUTH_EMAIL_VERIFICATION_URL=http://localhost:8080/api/v1/auth/verify-email-link
APP_AUTH_REFRESH_COOKIE_SECURE=false
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Lax

# Admin seeder
ADMIN_EMAIL=admin@lastbite.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=LastBite Admin

# AWS S3 direct media upload
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=lastbite
AWS_S3_UPLOAD_EXPIRE_SECONDS=300
AWS_S3_MAX_IMAGE_SIZE_MB=5
AWS_S3_MAX_VIDEO_SIZE_MB=50
AWS_S3_PUBLIC_BASE_URL=https://lastbite.s3.amazonaws.com

# Firebase Cloud Messaging
# APP_FCM_ENABLED=false keeps the backend running without Firebase in local/dev.
# Use one of APP_FCM_CREDENTIALS_PATH or APP_FCM_CREDENTIALS_BASE64 in staging/prod.
APP_FCM_ENABLED=false
APP_FCM_CREDENTIALS_PATH=
APP_FCM_CREDENTIALS_BASE64=
APP_NOTIFICATIONS_REMINDER_FIXED_DELAY_MS=60000

# Payments
# APP_PAYMENTS_GATEWAY=fake for local tests; use payos only with real credentials.
APP_PAYMENTS_GATEWAY=fake
APP_PAYMENTS_RETURN_URL=http://localhost:3000/orders/payment-return
APP_PAYMENTS_CANCEL_URL=http://localhost:3000/orders/payment-cancel
APP_PAYMENTS_RESERVATION_TTL_MINUTES=10
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# JVM trong container
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0 -XX:InitialRAMPercentage=10.0 -Dfile.encoding=UTF-8

# Profile đang dùng
SPRING_PROFILES_ACTIVE=dev
